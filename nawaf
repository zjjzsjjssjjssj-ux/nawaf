-- ==================== [ 5. محرك الأسيست - بدون تغيير السرعة ] ====================
RunService.Heartbeat:Connect(function()
    if not Settings.AutoActive then return end

    local character = localPlayer.Character
    if not character then return end

    local hasTool = false
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") then
            hasTool = true
            break
        end
    end

    if not hasTool then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not rootPart then return end

    -- ✅ نتأكد إن السرعة عادية (16)
    if humanoid.WalkSpeed ~= 16 then
        humanoid.WalkSpeed = 16
    end

    local nearestTarget = nil
    local shortestDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local targetHrp = p.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = p.Character:FindFirstChildOfClass("Humanoid")

            if targetHrp and targetHum and targetHum.Health > 0 then
                local dist = (rootPart.Position - targetHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearestTarget = targetHrp
                end
            end
        end
    end

    if nearestTarget then
        humanoid:MoveTo(nearestTarget.Position)
    end
end)

